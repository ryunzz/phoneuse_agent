{
  "name": "phoneuse-gateway",
  "version": "0.1.0",
  "description": "Hosted MCP gateway that routes Claude tool calls to Phone Use hardware rigs",
  "type": "module",
  "private": true,
  "engines": {
    "bun": ">=1.3"
  },
